<Window x:Class="Brim.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brim Notch" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="680" Height="340" UseLayoutRounding="True"
        FontFamily="{StaticResource Brim.Font}" Foreground="{DynamicResource Brim.Text}">
    <Grid>
        <StackPanel x:Name="ShapeRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Path x:Name="EarL" Width="10" Height="10" VerticalAlignment="Top" Fill="{DynamicResource Brim.Surface}"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"/>

            <Border x:Name="Body" Width="190" Height="32" VerticalAlignment="Top" ClipToBounds="True" AllowDrop="True"
                    Background="{DynamicResource Brim.Surface}" CornerRadius="0,0,12,12">
                <Grid>
                    <Border x:Name="Tint" Opacity="0" IsHitTestVisible="False"/>

                    <!-- Closed: a quiet pill -->
                    <Grid x:Name="ClosedView" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MiniArt" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="FaceText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                        <StackPanel x:Name="MiniBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Visibility="Collapsed">
                            <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{DynamicResource Brim.Accent}"/>
                            <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{DynamicResource Brim.Accent}"/>
                            <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{DynamicResource Brim.Accent}"/>
                            <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="{DynamicResource Brim.Accent}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Peek: song pop-up when the track changes -->
                    <Grid x:Name="PeekView" Width="360" Height="66" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Grid Margin="16,10,18,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PeekArt" Width="44" Height="44" CornerRadius="10"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PeekTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PeekArtist" FontSize="12" Foreground="{DynamicResource Brim.Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Live activity: volume, charging, headphones, mic, timer, colour picker -->
                    <Grid x:Name="ActivityView" Width="330" Height="46" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ActGlyph" FontFamily="{StaticResource Brim.Icons}" FontSize="16" VerticalAlignment="Center" Width="22" TextAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ActTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="ActLevel" Style="{StaticResource ThinBar}" Margin="0,5,0,0" Maximum="100" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="ActValue" Grid.Column="2" FontSize="12" Foreground="{DynamicResource Brim.Dim}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Open: the card -->
                    <Grid x:Name="OpenView" Width="580" Height="244" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Grid x:Name="OpenInner" Margin="20,12,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="TabsRow" Orientation="Horizontal">
                                <RadioButton x:Name="TabHome" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE80F;" ToolTip="Home" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabApps" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE71D;" ToolTip="Shortcuts" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabGames" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE7FC;" ToolTip="Games" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabMsgs" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE8BD;" ToolTip="Messages" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabShelf" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE896;" ToolTip="Shelf" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabClip" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE77F;" ToolTip="Clipboard" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabCtrl" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE701;" ToolTip="Wi-Fi, Bluetooth, sound" Checked="Tab_Checked"/>

                                <RadioButton x:Name="TabTimer" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE916;" ToolTip="Focus timer" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabNotes" GroupName="NotchTabs" Style="{StaticResource TabButton}" Content="&#xE70B;" ToolTip="Notes" Checked="Tab_Checked"/>
                            </StackPanel>
                            <!-- The tab's name sits between the tabs and the buttons and shortens with … rather than overlapping either -->
                            <TextBlock x:Name="HeaderInfo" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                       Foreground="{DynamicResource Brim.Dim}" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE722;" ToolTip="Screenshot (lands on your shelf)" Click="Screenshot_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                            </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,0">

                                <!-- HOME: now playing + glance -->
                                <Grid x:Name="HomePanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="MusicArea">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="112" Height="112" CornerRadius="16" Background="{DynamicResource Brim.Raised}" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource Brim.Icons}" FontSize="30"
                                                           Foreground="{DynamicResource Brim.Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border x:Name="ArtImage" CornerRadius="16"/>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="16,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="SongTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Nothing playing"/>
                                            <TextBlock x:Name="SongArtist" Grid.Row="1" FontSize="13" Foreground="{DynamicResource Brim.Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       Text="Play something in Spotify, a browser or any player"/>
                                            <TextBlock x:Name="SongSource" Grid.Row="2" FontSize="11" Foreground="{DynamicResource Brim.Dim}" Opacity="0.7" Margin="0,2,0,0"/>
                                            <StackPanel x:Name="RecentGames" Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Bottom" Visibility="Collapsed" Margin="0,0,0,2">
                                                <TextBlock Text="Jump back in" FontSize="11" Foreground="{DynamicResource Brim.Dim}" Margin="0,0,0,5"/>
                                                <StackPanel x:Name="RecentGamesList" Orientation="Horizontal"/>
                                            </StackPanel>
                                            <Grid Grid.Row="4" x:Name="ProgressRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Elapsed" FontSize="11" Foreground="{DynamicResource Brim.Dim}" VerticalAlignment="Center"/>
                                                <Slider x:Name="Progress" Grid.Column="1" Style="{StaticResource BrimSlider}" Minimum="0" Maximum="1"/>
                                                <TextBlock x:Name="Remaining" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Brim.Dim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="15" Width="40" Height="40" Click="Prev_Click"/>
                                                <Button x:Name="PlayBtn" Style="{StaticResource RoundButton}" Content="&#xE768;" Margin="10,0" Click="Play_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="15" Width="40" Height="40" Click="Next_Click"/>                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- The glance column: its parts are shown, hidden and ordered from Settings › Notch › Home tab -->
                                    <ScrollViewer x:Name="GlanceScroll" Grid.Column="2" VerticalScrollBarVisibility="Hidden">
                                    <WrapPanel x:Name="Glance" Orientation="Horizontal">
                                        <StackPanel x:Name="DateBlock">
                                            <Grid x:Name="DayRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="DayText" FontSize="12" Foreground="{DynamicResource Brim.Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <!-- Connected controllers and headphones, with battery -->
                                                <StackPanel x:Name="DeviceChips" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="DateText" FontSize="26" FontWeight="SemiBold" Margin="0,-2,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="WeatherBlock" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="WeatherGlyph" FontFamily="{StaticResource Brim.Symbols}" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="WeatherText" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="WeatherPlace" FontSize="11" Foreground="{DynamicResource Brim.Dim}" Margin="8,2,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="70"/>
                                        </StackPanel>
                                        <StackPanel x:Name="BatteryBlock" Margin="0,10,0,0">
                                            <Grid>
                                                <TextBlock Text="Battery" FontSize="11" Foreground="{DynamicResource Brim.Dim}"/>
                                                <TextBlock x:Name="BatteryText" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar x:Name="BatteryBar" Style="{StaticResource ThinBar}" Margin="0,4,0,0" Maximum="100"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CpuBlock" Margin="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource Brim.Dim}"/>
                                                <TextBlock x:Name="CpuText" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar x:Name="CpuBar" Style="{StaticResource ThinBar}" Margin="0,4,0,0" Maximum="100"/>
                                        </StackPanel>
                                        <StackPanel x:Name="RamBlock" Margin="0,9,0,0">
                                            <Grid>
                                                <TextBlock Text="Memory" FontSize="11" Foreground="{DynamicResource Brim.Dim}"/>
                                                <TextBlock x:Name="RamText" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar x:Name="RamBar" Style="{StaticResource ThinBar}" Margin="0,4,0,0" Maximum="100"/>
                                        </StackPanel>
                                        <Grid x:Name="VolumeBlock" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="13" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute"/>
                                            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource BrimSlider}" Minimum="0" Maximum="1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                        </Grid>
                                        <Border x:Name="MessageBlock" Margin="0,10,0,0" CornerRadius="10" Padding="9,6" Background="{DynamicResource Brim.Raised}" Cursor="Hand"
                                                MouseLeftButtonUp="MessageBlock_Click">
                                            <StackPanel>
                                                <TextBlock x:Name="MsgFrom" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="MsgLine" FontSize="11" Foreground="{DynamicResource Brim.Dim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    </ScrollViewer>
                                </Grid>

                                <!-- SHORTCUTS -->
                                <Grid x:Name="AppsPanel" Visibility="Collapsed" AllowDrop="True" Background="Transparent">
                                    <ItemsControl x:Name="AppsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Tile}" Width="89" Height="82" Tag="{Binding}" ToolTip="{Binding Tip}" Opacity="{Binding DragOpacity}"
                                                        Click="AppTile_Click" MouseRightButtonUp="AppTile_RightClick"
                                                        PreviewMouseLeftButtonDown="AppTile_Press" PreviewMouseMove="AppTile_DragMove" PreviewMouseLeftButtonUp="AppTile_DragEnd">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Grid Width="38" Height="38">
                                                                <Image Source="{Binding Icon}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Brim.Icons}" FontSize="24"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                                       Margin="4,6,4,0" MaxWidth="80"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Badge}" FontSize="9" Foreground="{DynamicResource Brim.Dim}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- SHELF -->
                                <Grid x:Name="ShelfPanel" Visibility="Collapsed" Background="Transparent">
                                    <Border x:Name="ShelfEmpty" CornerRadius="14" BorderThickness="1.5" BorderBrush="{DynamicResource Brim.Stroke}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Brim.Icons}" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Brim.Dim}"/>
                                            <TextBlock Text="Drop files here to keep them handy" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Drag them back out into any app later" FontSize="11" Foreground="{DynamicResource Brim.Dim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid x:Name="ShelfFull" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                            <ItemsControl x:Name="ShelfList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Tile}" Width="89" Height="76" Tag="{Binding}" ToolTip="{Binding Path}"
                                                                PreviewMouseLeftButtonDown="ShelfItem_Down" PreviewMouseMove="ShelfItem_Move" Click="ShelfItem_Click"
                                                                MouseDoubleClick="ShelfItem_Open" MouseRightButtonUp="ShelfItem_RightClick">
                                                            <Grid>
                                                                <Border CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Brim.Accent}" Background="{DynamicResource Brim.Hover}"
                                                                        Visibility="{Binding SelectedVisibility}"/>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <Image Source="{Binding Icon}" Width="34" Height="34"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="4,5,4,0" MaxWidth="80"/>
                                                                </StackPanel>
                                                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brim.Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                        Margin="6,5,0,0" Visibility="{Binding SelectedVisibility}">
                                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Brim.Icons}" FontSize="9" Foreground="{DynamicResource Brim.OnAccent}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <TextBlock x:Name="ShelfInfo" FontSize="11.5" Foreground="{DynamicResource Brim.Dim}" VerticalAlignment="Center"
                                                       Text="Click files to select · drag to move or copy"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="ShelfCopyBtn" Style="{StaticResource Pill}" Content="Copy" Margin="0,0,6,0" Click="ShelfCopy_Click" ToolTip="Copy the selected files, then paste anywhere"/>
                                                <Button x:Name="ShelfRemoveBtn" Style="{StaticResource Pill}" Content="Remove" Margin="0,0,6,0" Click="ShelfRemove_Click"/>
                                                <Button x:Name="ShelfAllBtn" Style="{StaticResource Pill}" Content="Select all" Margin="0,0,6,0" Click="ShelfAll_Click"/>
                                                <Button Style="{StaticResource Pill}" Content="Clear" Click="ShelfClear_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- FOCUS TIMER (built on demand) -->
                                <Grid x:Name="TimerPanel" Visibility="Collapsed"/>

                                <!-- NOTES (built on demand) -->
                                <Grid x:Name="NotesPanel" Visibility="Collapsed"/>

                                <!-- GAMES (built on demand) -->
                                <Grid x:Name="GamesPanel" Visibility="Collapsed"/>

                                <!-- QUICK CONTROLS (built on demand) -->
                                <Grid x:Name="CtrlPanel" Visibility="Collapsed"/>

                                <!-- MESSAGES (built on demand) -->
                                <Grid x:Name="MsgPanel" Visibility="Collapsed"/>

                                <!-- CLIPBOARD -->
                                <Grid x:Name="ClipPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,6">
                                        <TextBox x:Name="ClipSearch" Style="{StaticResource Field}" FontSize="12.5" Padding="30,5,8,5"
                                                 PreviewMouseLeftButtonDown="ClipSearch_Click" TextChanged="ClipSearch_Changed"/>
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Brim.Icons}" FontSize="12" Foreground="{DynamicResource Brim.Dim}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="ClipSearchHint" Text="Search your clipboard" FontSize="12.5" Foreground="{DynamicResource Brim.Dim}"
                                                   VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Things you copy will show up here" FontSize="13" Foreground="{DynamicResource Brim.Dim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="ClipList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Tile}" Height="{Binding RowHeight}" Tag="{Binding}" Click="Clip_Click" MouseRightButtonUp="Clip_RightClick">
                                                        <Grid Margin="10,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MinWidth="22"/>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Brim.Icons}" FontSize="12" Foreground="{DynamicResource Brim.Dim}" VerticalAlignment="Center"
                                                                       Visibility="{Binding GlyphVisibility}"/>
                                                            <Border Visibility="{Binding ThumbVisibility}" CornerRadius="5" Height="42" MaxWidth="90" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Image Source="{Binding Thumb}" Stretch="Uniform" Height="42"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock Text="&#xE718;" FontFamily="{StaticResource Brim.Icons}" FontSize="11" Foreground="{DynamicResource Brim.Accent}"
                                                                           Visibility="{Binding PinVisibility}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Ago}" FontSize="11" Foreground="{DynamicResource Brim.Dim}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Path x:Name="EarR" Width="10" Height="10" VerticalAlignment="Top" Fill="{DynamicResource Brim.Surface}"
                  Data="M10,0 L0,0 L0,10 A10,10 0 0 1 10,0 Z"/>
        </StackPanel>
    </Grid>
</Window>
