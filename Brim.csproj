<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Newer C#/WinRT (the bridge to Windows APIs like media and notifications): fixes in releasing Windows objects -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Brim</AssemblyName>
    <RootNamespace>Brim</RootNamespace>
    <Version>0.6.60</Version>
    <ApplicationIcon>Assets\brim.ico</ApplicationIcon>
    <!-- Declares Windows 8+ support (needed for the live wallpaper's own layer); keeps WPF's system DPI awareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Brim</Product>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8604;CS8600;CS8622;CA1416</NoWarn>

    <!-- Memory: a small UI app does not need a background GC thread or profile-guided rejitting -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Startup: ship precompiled code so launching doesn't wait on the JIT (about 0.4 s faster) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prefer smaller heaps over fewer collections -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Built-in API keys: the private file when it's here, otherwise the empty stand-in (public source) -->
  <ItemGroup>
    <Compile Remove="Core\ApiKeys.Empty.cs" Condition="Exists('Core\ApiKeys.Local.cs')" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\brim-64.png" />
    <None Remove="Assets\brim-256.png;Assets\brim-512.png" />
  </ItemGroup>

  <!-- The admin helper (Helper\BrimAdmin.cs): a separate tiny .NET Framework exe, compiled by the C# compiler that
       ships with Windows and carried inside Brim, which installs it into Program Files when you allow it -->
  <PropertyGroup>
    <AdminHelperExe>$(BaseIntermediateOutputPath)admin\BrimAdmin.exe</AdminHelperExe>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Helper\**" />
    <None Remove="Helper\**" />
    <EmbeddedResource Include="$(AdminHelperExe)" LogicalName="BrimAdmin.exe" Visible="false" />
  </ItemGroup>
  <Target Name="BuildAdminHelper" BeforeTargets="BeforeBuild" Inputs="Helper\BrimAdmin.cs" Outputs="$(AdminHelperExe)">
    <MakeDir Directories="$(BaseIntermediateOutputPath)admin" />
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; -nologo -target:winexe -optimize+ &quot;-out:$(AdminHelperExe)&quot; Helper\BrimAdmin.cs" />
  </Target>

</Project>
