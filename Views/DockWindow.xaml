<Window x:Class="Brim.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brim Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{StaticResource Brim.Font}" Foreground="{DynamicResource Brim.Text}">
    <Border x:Name="Bar" Background="{DynamicResource Brim.Surface}" BorderBrush="{DynamicResource Brim.Stroke}" BorderThickness="1"
            CornerRadius="18" Padding="6" Margin="0,0,0,8">
        <StackPanel x:Name="BarContent" Orientation="Horizontal">
            <Button x:Name="StartBtn" Style="{StaticResource Tile}" Click="Start_Click" ToolTip="Start">
                <Grid x:Name="StartGlyph" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Margin="0,0,1,1" CornerRadius="2" Background="{DynamicResource Brim.Accent}"/>
                    <Border Grid.Column="1" Margin="1,0,0,1" CornerRadius="2" Background="{DynamicResource Brim.Accent}"/>
                    <Border Grid.Row="1" Margin="0,1,1,0" CornerRadius="2" Background="{DynamicResource Brim.Accent}"/>
                    <Border Grid.Row="1" Grid.Column="1" Margin="1,1,0,0" CornerRadius="2" Background="{DynamicResource Brim.Accent}"/>
                </Grid>
            </Button>

            <ItemsControl x:Name="Apps">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Tile}" Tag="{Binding}" Margin="{Binding TileMargin}" MouseEnter="App_Enter" MouseLeave="App_Leave"
                                Width="{Binding TileSize}" Height="{Binding TileSize}"
                                Click="App_Click" MouseRightButtonUp="App_RightClick" MouseUp="App_MiddleClick"
                                PreviewMouseLeftButtonDown="App_PressDrag" PreviewMouseMove="App_DragMove" PreviewMouseLeftButtonUp="App_DragEnd"
                                AllowDrop="True" DragOver="App_DragOver" Drop="App_Drop">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE737;" FontFamily="{StaticResource Brim.Icons}" FontSize="18" Visibility="{Binding GlyphVisibility}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1"
                                        Width="{Binding DotWidth}" Background="{Binding DotBrush}" Visibility="{Binding DotVisibility}"/>
                                <!-- Downloading something right now -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Width="15" Height="15" CornerRadius="7.5"
                                        Background="#FF3B82F6" BorderBrush="{DynamicResource Brim.Surface}" BorderThickness="1.5"
                                        Visibility="{Binding DownloadVisibility}" ToolTip="Downloading">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Brim.Icons}" FontSize="8" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Something to see in this app (a notification, an unread count, or it asked for attention) -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" MinWidth="{Binding BadgeWidth}" Height="{Binding BadgeHeight}"
                                        CornerRadius="8" Background="#FFE5484D" BorderBrush="{DynamicResource Brim.Surface}" BorderThickness="1.5"
                                        Visibility="{Binding BadgeVisibility}" Padding="3,0">
                                    <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Width="1" Margin="6,10" Background="{DynamicResource Brim.Stroke}"/>

            <Button x:Name="TaskMgrBtn" Style="{StaticResource Tile}" Width="30" Click="TaskMgr_Click" ToolTip="Task Manager" Visibility="Collapsed">
                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Brim.Icons}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="TrayBtn" Style="{StaticResource Tile}" Width="30" Click="Tray_Click" ToolTip="Apps running in the background">
                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Brim.Icons}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="WeatherBtn" Style="{StaticResource Tile}" Click="Weather_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="WeatherGlyph" FontFamily="{StaticResource Brim.Symbols}" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WeatherTemp" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="StatusBtn" Style="{StaticResource Tile}" Click="Status_Click" ToolTip="Wi-Fi, Bluetooth, sound and brightness">
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NetGlyph" Text="&#xE701;" FontFamily="{StaticResource Brim.Icons}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolGlyph" Text="&#xE767;" FontFamily="{StaticResource Brim.Icons}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="BatteryText" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClockBtn" Style="{StaticResource Tile}" Click="Clock_Click" ToolTip="Notifications and calendar" Padding="0">
                <StackPanel VerticalAlignment="Center" Margin="10,0">
                    <TextBlock x:Name="TimeText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DateText" FontSize="10.5" Foreground="{DynamicResource Brim.Dim}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Button>
            <Button x:Name="DesktopBtn" Style="{StaticResource Tile}" Width="16" ClickMode="Press" Margin="4,0,-2,0" Click="Desktop_Click" ToolTip="Show desktop (click again to go back)">
                <Border Width="2" Height="20" CornerRadius="1" Background="{DynamicResource Brim.Dim}" Opacity="0.6"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
